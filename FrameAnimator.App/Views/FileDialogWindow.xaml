<Window
    x:Class="FrameAnimator.App.Views.FileDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:FrameAnimator.App.Localization"
    Title="{Binding Title, Mode=OneTime}"
    Width="720"
    Height="460"
    MinWidth="560"
    MinHeight="340"
    FontSize="12"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary Source="/Themes/Compact.xaml" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand, Mode=OneTime}" />
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Navigation  -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                AutomationProperties.Name="{loc:T 'Back'}"
                Command="{Binding BackCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{loc:T 'Back'}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" />
            </Button>
            <Button
                Grid.Column="1"
                AutomationProperties.Name="{loc:T 'Up one level'}"
                Command="{Binding UpCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{loc:T 'Up one level'}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" />
            </Button>
            <TextBox
                Grid.Column="2"
                Margin="6,0,6,0"
                Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding NavigateToPathCommand, Mode=OneTime}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="{Binding FavoriteToolTip}"
                Command="{Binding ToggleFavoriteCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{Binding FavoriteToolTip}">
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding FavoriteGlyph}" />
            </Button>
            <Button
                Grid.Column="4"
                AutomationProperties.Name="{loc:T 'New folder'}"
                Command="{Binding NewFolderCommand, Mode=OneTime}"
                Style="{StaticResource ToolButton}"
                ToolTip="{loc:T 'New folder'}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Favorites, then places  -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MaxHeight="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="4,0,0,4"
                    FontWeight="SemiBold"
                    Text="{loc:T 'Favorites'}" />
                <Grid Grid.Row="1">
                    <ListBox
                        x:Name="FavoritesList"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding Favorites, Mode=OneTime}"
                        PreviewMouseRightButtonDown="OnFavoritesRightClick"
                        SelectionChanged="OnFavoriteChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding RemoveFavoriteCommand, Mode=OneTime}" Header="{loc:T 'Remove from favorites'}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="ToolTip" Value="{Binding Path}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock
                        Margin="6,4"
                        IsHitTestVisible="False"
                        Opacity="0.6"
                        Text="{loc:T 'Click the star to add the current folder.'}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowFavoritesHint}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock
                    Grid.Row="2"
                    Margin="4,10,0,4"
                    FontWeight="SemiBold"
                    Text="{loc:T 'Places'}" />
                <ListBox
                    x:Name="PlacesList"
                    Grid.Row="3"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding Places, Mode=OneTime}"
                    SelectionChanged="OnPlaceChanged">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <DockPanel Grid.Column="2">
                <Grid
                    Margin="26,0,12,4"
                    DockPanel.Dock="Top"
                    Opacity="0.7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:T 'Name'}" />
                    <TextBlock Grid.Column="1" Text="{loc:T 'Date modified'}" />
                    <TextBlock Grid.Column="2" Text="{loc:T 'Size'}" />
                </Grid>
                <ListBox
                    x:Name="FilesList"
                    ItemsSource="{Binding Entries}"
                    KeyDown="OnFilesKeyDown"
                    MouseDoubleClick="OnFileDoubleClick"
                    PreviewMouseRightButtonDown="OnFilesRightClick"
                    SelectionChanged="OnFileSelectionChanged"
                    SelectionMode="{Binding SelectionMode, Mode=OneTime}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding AddToFavoritesCommand, Mode=OneTime}" Header="{Binding FileMenuFavoriteHeader}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Width="18"
                                    Height="18"
                                    FontSize="14"
                                    LineHeight="18"
                                    Style="{StaticResource Glyph}"
                                    Text="{Binding Glyph}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Opacity="0.7"
                                    Text="{Binding Modified}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Opacity="0.7"
                                    Text="{Binding SizeText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="{loc:T 'File name:'}" />
            <TextBox
                x:Name="NameBox"
                Grid.Column="1"
                Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                Grid.Column="2"
                MinWidth="230"
                Margin="8,0,0,0"
                DisplayMemberPath="Display"
                ItemsSource="{Binding Filters, Mode=OneTime}"
                SelectedItem="{Binding SelectedFilter}" />
        </Grid>

        <StackPanel
            Grid.Row="3"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="80"
                Margin="0,0,8,0"
                Command="{Binding OkCommand, Mode=OneTime}"
                Content="{Binding OkText, Mode=OneTime}"
                IsDefault="True" />
            <Button
                MinWidth="80"
                Content="{loc:T 'Cancel'}"
                IsCancel="True" />
        </StackPanel>
    </Grid>

</Window>