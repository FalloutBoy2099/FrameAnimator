<Window x:Class="FrameAnimator.App.Views.FileDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FrameAnimator.App.Localization"
        Width="720" Height="460" MinWidth="560" MinHeight="340" FontSize="12"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Compact.xaml" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{x:Static NavigationCommands.Refresh}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static NavigationCommands.Refresh}" Executed="OnRefresh" />
    </Window.CommandBindings>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Click="OnBack"
                    ToolTip="{loc:T 'Back'}" AutomationProperties.Name="{loc:T 'Back'}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" />
            </Button>
            <Button x:Name="UpButton" Grid.Column="1" Style="{StaticResource ToolButton}" Click="OnUp"
                    ToolTip="{loc:T 'Up one level'}" AutomationProperties.Name="{loc:T 'Up one level'}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" />
            </Button>
            <TextBox x:Name="PathBox" Grid.Column="2" Margin="6,0,6,0" KeyDown="OnPathKeyDown" />
            <Button x:Name="FavoriteButton" Grid.Column="3" Style="{StaticResource ToolButton}" Click="OnToggleFavorite">
                <TextBlock x:Name="FavoriteGlyph" Style="{StaticResource Glyph}" Text="&#xE734;" />
            </Button>
            <Button x:Name="NewFolderButton" Grid.Column="4" Style="{StaticResource ToolButton}" Click="OnNewFolder"
                    ToolTip="{loc:T 'New folder'}" AutomationProperties.Name="{loc:T 'New folder'}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Favoris puis lieux -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MaxHeight="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:T 'Favorites'}" FontWeight="SemiBold" Margin="4,0,0,4" />
                <Grid Grid.Row="1">
                    <ListBox x:Name="FavoritesList" DisplayMemberPath="Label" SelectionChanged="OnFavoriteChanged"
                             PreviewMouseRightButtonDown="OnFavoritesRightClick">
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="OnFavoritesMenuOpened">
                                <MenuItem x:Name="RemoveFavoriteMenu" Header="{loc:T 'Remove from favorites'}" Click="OnRemoveFavorite" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="ToolTip" Value="{Binding Path}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock x:Name="FavoritesHint" Text="{loc:T 'Click the star to add the current folder.'}"
                               TextWrapping="Wrap" Opacity="0.6" Margin="6,4" IsHitTestVisible="False" />
                </Grid>
                <TextBlock Grid.Row="2" Text="{loc:T 'Places'}" FontWeight="SemiBold" Margin="4,10,0,4" />
                <ListBox x:Name="PlacesList" Grid.Row="3" DisplayMemberPath="Label" SelectionChanged="OnPlaceChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top" Margin="26,0,12,4" Opacity="0.7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:T 'Name'}" />
                    <TextBlock Grid.Column="1" Text="{loc:T 'Date modified'}" />
                    <TextBlock Grid.Column="2" Text="{loc:T 'Size'}" />
                </Grid>
                <ListBox x:Name="FilesList" SelectionChanged="OnFileSelectionChanged"
                         MouseDoubleClick="OnFileDoubleClick" KeyDown="OnFilesKeyDown"
                         PreviewMouseRightButtonDown="OnFilesRightClick">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="OnFilesMenuOpened">
                            <MenuItem x:Name="FileMenuFavorite" Click="OnFileMenuFavorite" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" FontSize="14" Width="18" Height="18" LineHeight="18"
                                           Text="{Binding Glyph}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Modified}" Opacity="0.7" />
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:T 'File name:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="NameBox" Grid.Column="1" />
            <ComboBox x:Name="FilterBox" Grid.Column="2" Margin="8,0,0,0" MinWidth="230" SelectionChanged="OnFilterChanged" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" MinWidth="80" IsDefault="True" Margin="0,0,8,0" Click="OnOk" />
            <Button Content="{loc:T 'Cancel'}" MinWidth="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
