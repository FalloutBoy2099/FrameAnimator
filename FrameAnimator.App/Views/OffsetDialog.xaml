<Window
    x:Class="FrameAnimator.App.Views.OffsetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:FrameAnimator.App.Localization"
    Title="{Binding Title, Mode=OneTime}"
    FontSize="12"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Compact.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,12,8"
            VerticalAlignment="Center"
            Text="{loc:T 'At X'}" />
        <TextBox
            x:Name="XBox"
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,0,8"
            Text="{Binding XText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            Grid.Row="1"
            Margin="0,0,12,8"
            VerticalAlignment="Center"
            Text="{loc:T 'At Y'}" />
        <TextBox
            x:Name="YBox"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,8"
            Text="{Binding YText, UpdateSourceTrigger=PropertyChanged}" />
        <Button
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="2"
            Margin="12,0,0,8"
            VerticalAlignment="Center"
            Command="{Binding WizardCommand, Mode=OneTime}"
            Content="{loc:T 'Wizard'}"
            ToolTip="{loc:T 'Computes Y so the animation follows the direction axis'}"
            Visibility="{Binding ShowWizard, Mode=OneTime, Converter={StaticResource BoolToVis}}" />
        <CheckBox
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Margin="0,0,0,12"
            Content="{loc:T 'Inherit shift down'}"
            IsChecked="{Binding Inherit}"
            IsEnabled="{Binding InheritEnabled, Mode=OneTime}"
            Visibility="{Binding ShowInherit, Mode=OneTime, Converter={StaticResource BoolToVis}}" />

        <StackPanel
            Grid.Row="3"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Command="{Binding OkCommand, Mode=OneTime}"
                Content="{loc:T 'OK'}"
                IsDefault="True" />
            <Button
                Width="80"
                Content="{loc:T 'Cancel'}"
                IsCancel="True" />
        </StackPanel>
    </Grid>

</Window>