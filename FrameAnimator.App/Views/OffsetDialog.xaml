<Window FontSize="12" x:Class="FrameAnimator.App.Views.OffsetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FrameAnimator.App.Localization"
        Title="Offset" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Compact.xaml" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:T 'At X'}" VerticalAlignment="Center" Margin="0,0,12,8" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="XBox" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="{loc:T 'At Y'}" VerticalAlignment="Center" Margin="0,0,12,8" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="YBox" Margin="0,0,0,8" />
        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" x:Name="WizardButton" Content="{loc:T 'Wizard'}" Margin="12,0,0,8"
                VerticalAlignment="Center" Click="OnWizard" ToolTip="{loc:T 'Computes Y so the animation follows the direction axis'}" />
        <CheckBox Grid.Row="2" Grid.ColumnSpan="3" x:Name="InheritBox" Content="{loc:T 'Inherit shift down'}" Margin="0,0,0,12" />

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:T 'OK'}" Width="80" IsDefault="True" Margin="0,0,8,0" Click="OnOk" />
            <Button Content="{loc:T 'Cancel'}" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
