<Window
	x:Class="FrameAnimator.App.Views.AnimationPreviewWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:FrameAnimator.App.Controls"
	xmlns:loc="clr-namespace:FrameAnimator.App.Localization"
	Title="{loc:T 'Animation preview'}"
	Width="320"
	Height="360"
	MinWidth="220"
	MinHeight="240"
	FontSize="12"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Window.Resources>
		<ResourceDictionary Source="/Themes/Compact.xaml" />
	</Window.Resources>

	<Window.InputBindings>
		<KeyBinding Key="Space" Command="{Binding PlayPauseCommand, Mode=OneTime}" />
		<KeyBinding Key="Right" Command="{Binding StepForwardCommand, Mode=OneTime}" />
		<KeyBinding Key="Left" Command="{Binding StepBackCommand, Mode=OneTime}" />
	</Window.InputBindings>

	<DockPanel>
		<StackPanel
			Margin="8,6"
			DockPanel.Dock="Bottom"
			Orientation="Horizontal">
			<Button
				AutomationProperties.Name="{loc:T 'Previous frame'}"
				Command="{Binding StepBackCommand, Mode=OneTime}"
				Style="{StaticResource ToolButton}"
				ToolTip="{loc:T 'Previous frame'}">
				<TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" />
			</Button>
			<Button
				AutomationProperties.Name="{loc:T 'Play'}"
				Command="{Binding PlayPauseCommand, Mode=OneTime}"
				Style="{StaticResource ToolButton}"
				ToolTip="{Binding PlayPauseToolTip}">
				<TextBlock Style="{StaticResource Glyph}" Text="{Binding PlayPauseGlyph}" />
			</Button>
			<Button
				AutomationProperties.Name="{loc:T 'Next frame'}"
				Command="{Binding StepForwardCommand, Mode=OneTime}"
				Style="{StaticResource ToolButton}"
				ToolTip="{loc:T 'Next frame'}">
				<TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" />
			</Button>
			<TextBlock
				Margin="12,0,0,0"
				VerticalAlignment="Center"
				Text="{Binding Caption}" />
		</StackPanel>
		<Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
			<controls:FramePreview />
		</Border>
	</DockPanel>

</Window>
