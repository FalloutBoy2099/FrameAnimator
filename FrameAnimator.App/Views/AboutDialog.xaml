<Window
	x:Class="FrameAnimator.App.Views.AboutDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:loc="clr-namespace:FrameAnimator.App.Localization"
	Title="{loc:T 'About'}"
	FontSize="12"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="WidthAndHeight"
	WindowStartupLocation="CenterOwner">

	<Window.Resources>
		<ResourceDictionary Source="/Themes/Compact.xaml" />
	</Window.Resources>

	<StackPanel MaxWidth="400" Margin="24">
		<StackPanel Margin="0,0,0,16" Orientation="Horizontal">
			<Image
				Width="48"
				Height="48"
				Margin="0,0,16,0"
				Source="pack://application:,,,/Assets/app.ico" />
			<StackPanel VerticalAlignment="Center">
				<TextBlock
					FontSize="18"
					FontWeight="SemiBold"
					Text="{Binding ProductName, Mode=OneTime}" />
				<TextBlock Margin="0,4,0,0" Text="{Binding Author, Mode=OneTime}" />
				<TextBlock Opacity="0.7" Text="{Binding Version, Mode=OneTime}" />
			</StackPanel>
		</StackPanel>
		<TextBlock
			Margin="0,0,0,16"
			Opacity="0.7"
			Text="{loc:T 'Rewrite in .NET 10 / WPF of Frame Animator 2.70.1 by Jochua'}"
			TextWrapping="Wrap" />
		<Button
			Width="80"
			HorizontalAlignment="Right"
			Command="{Binding CloseCommand, Mode=OneTime}"
			Content="{loc:T 'OK'}"
			IsCancel="True"
			IsDefault="True" />
	</StackPanel>

</Window>