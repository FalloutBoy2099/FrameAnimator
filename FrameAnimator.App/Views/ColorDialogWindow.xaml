<Window FontSize="12" x:Class="FrameAnimator.App.Views.ColorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FrameAnimator.App.Localization"
        Title="{loc:T 'Sample Color'}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Compact.xaml" />
    </Window.Resources>
    <Grid Margin="16" Width="340">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="3" x:Name="Preview" Height="56" CornerRadius="4" BorderThickness="1" Margin="0,0,0,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <TextBlock Grid.Row="1" Text="R" VerticalAlignment="Center" />
        <Slider Grid.Row="1" Grid.Column="1" x:Name="RSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="RText" HorizontalAlignment="Right" VerticalAlignment="Center" />

        <TextBlock Grid.Row="2" Text="G" VerticalAlignment="Center" />
        <Slider Grid.Row="2" Grid.Column="1" x:Name="GSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="GText" HorizontalAlignment="Right" VerticalAlignment="Center" />

        <TextBlock Grid.Row="3" Text="B" VerticalAlignment="Center" />
        <Slider Grid.Row="3" Grid.Column="1" x:Name="BSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
        <TextBlock Grid.Row="3" Grid.Column="2" x:Name="BText" HorizontalAlignment="Right" VerticalAlignment="Center" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,12">
            <TextBlock Text="Hex  #" VerticalAlignment="Center" />
            <TextBox x:Name="HexBox" Width="100" MaxLength="6" TextChanged="OnHexChanged" />
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:T 'OK'}" Width="80" IsDefault="True" Margin="0,0,8,0" Click="OnOk" />
            <Button Content="{loc:T 'Cancel'}" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
