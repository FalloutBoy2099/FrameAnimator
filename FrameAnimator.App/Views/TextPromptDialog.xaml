<Window
    x:Class="FrameAnimator.App.Views.TextPromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:FrameAnimator.App.Localization"
    Title="{Binding Title, Mode=OneTime}"
    Width="380"
    FontSize="12"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary Source="/Themes/Compact.xaml" />
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Margin="0,0,0,6" Text="{Binding Prompt, Mode=OneTime}" />
        <TextBox
            x:Name="Input"
            Margin="0,0,0,14"
            Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                MinWidth="80"
                Margin="0,0,8,0"
                Command="{Binding OkCommand, Mode=OneTime}"
                Content="{loc:T 'OK'}"
                IsDefault="True" />
            <Button
                MinWidth="80"
                Content="{loc:T 'Cancel'}"
                IsCancel="True" />
        </StackPanel>
    </StackPanel>

</Window>
