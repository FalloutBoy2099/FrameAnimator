<Window
    x:Class="FrameAnimator.App.Views.OptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:FrameAnimator.App.Localization"
    Title="{loc:T 'Options'}"
    FontSize="12"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary Source="/Themes/Compact.xaml" />
    </Window.Resources>

    <StackPanel
        MinWidth="340"
        Margin="16"
        Grid.IsSharedSizeScope="True">
        <GroupBox
            Margin="0,0,0,10"
            Padding="8"
            Header="{loc:T 'Transparent Color'}">
            <StackPanel>
                <RadioButton
                    Margin="0,0,0,4"
                    Content="{loc:T 'Auto (pixel 0,0 of each frame)'}"
                    GroupName="t"
                    IsChecked="{Binding IsAutoTransparent}" />
                <RadioButton
                    Margin="0,0,0,4"
                    Content="{loc:T 'From Palette (entry 0)'}"
                    GroupName="t"
                    IsChecked="{Binding IsPaletteTransparent}" />
                <RadioButton
                    Content="{loc:T 'Sample'}"
                    GroupName="t"
                    IsChecked="{Binding IsSampleTransparent}" />
            </StackPanel>
        </GroupBox>

        <GroupBox
            Margin="0,0,0,10"
            Padding="8"
            Header="{loc:T 'Frames Tune'}">
            <StackPanel>
                <CheckBox
                    Margin="0,0,0,4"
                    Content="{loc:T 'Autocutting'}"
                    IsChecked="{Binding AutoCutting}" />
                <CheckBox
                    Margin="0,0,0,8"
                    Content="{loc:T 'Lock Offsets'}"
                    IsChecked="{Binding LockOffsets}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        MinWidth="110"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Text="{loc:T 'Ghost (+/-)'}" />
                    <TextBox Width="80" Text="{Binding GhostText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox
            Margin="0,0,0,12"
            Padding="8"
            Header="{loc:T 'Advanced'}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="Auto"
                        MinWidth="130"
                        SharedSizeGroup="Labels" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,12,6"
                    VerticalAlignment="Center"
                    Text="{loc:T 'Dithering Method'}" />
                <ComboBox
                    Grid.Column="1"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding DitherMethods, Mode=OneTime}"
                    SelectedIndex="{Binding DitherIndex}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,0,12,6"
                    VerticalAlignment="Center"
                    Text="{loc:T 'Action Frame'}" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding ActionFrames, Mode=OneTime}"
                    SelectedIndex="{Binding ActionIndex}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,0,12,6"
                    VerticalAlignment="Center"
                    Text="{loc:T 'FPS'}" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,0,0,6"
                    Text="{Binding FpsText, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Content="{loc:T 'Original color matching (byte-identical FRM output)'}"
                    IsChecked="{Binding LegacyColorMatching}"
                    ToolTip="{loc:T 'The original program has a bug in its nearest-color search; keep this on to get identical files.'}" />
            </Grid>
        </GroupBox>

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Command="{Binding OkCommand, Mode=OneTime}"
                Content="{loc:T 'OK'}"
                IsDefault="True" />
            <Button
                Width="80"
                Content="{loc:T 'Cancel'}"
                IsCancel="True" />
        </StackPanel>
    </StackPanel>

</Window>