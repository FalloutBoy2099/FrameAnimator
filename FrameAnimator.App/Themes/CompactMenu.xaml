											<Setter TargetName="Icon" Property="FrameworkElement.Margin">
												<Setter.Value>
													<Thickness>0,0,0,0</Thickness>
												</Setter.Value>
											</Setter>
											<Setter TargetName="HeaderPresenter" Property="UIElement.Visibility">
												<Setter.Value>
													<x:Static Member="Visibility.Collapsed" />
												</Setter.Value>
											</Setter>
											<Trigger.Value>
												<x:Null />
											</Trigger.Value>
										</Trigger>
										<Trigger Property="MenuItem.IsHighlighted">
