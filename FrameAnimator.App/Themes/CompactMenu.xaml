													<DynamicResource ResourceKey="MenuBarItemBackgroundSelected" />
												</Setter.Value>
											</Setter>
											<Trigger.Value>
												<s:Boolean>True</s:Boolean>
											</Trigger.Value>
										</Trigger>
										<Trigger Property="UIElement.IsEnabled">
											<Setter Property="TextElement.Foreground">
												<Setter.Value>
													<SolidColorBrush Color="{DynamicResource TextFillColorDisabled}" />
												</Setter.Value>
											</Setter>
											<Trigger.Value>
												<s:Boolean>False</s:Boolean>
											</Trigger.Value>
										</Trigger>
										<Trigger Property="MenuItem.IsSubmenuOpen">
											<Trigger.EnterActions>
												<BeginStoryboard>
													<Storyboard>
														<Storyboard.Children>
															<DoubleAnimation
																Storyboard.TargetName="SubmenuBorder"
																Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
																From="-90"
																To="0"
																Duration="00:00:00.1670000">
																<DoubleAnimation.EasingFunction>
																	<CircleEase EasingMode="EaseOut" />
																</DoubleAnimation.EasingFunction>
															</DoubleAnimation>
														</Storyboard.Children>
													</Storyboard>
												</BeginStoryboard>
											</Trigger.EnterActions>
											<Trigger.Value>
												<s:Boolean>True</s:Boolean>
											</Trigger.Value>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Setter Property="Grid.IsSharedSizeScope">
							<Setter.Value>
								<s:Boolean>True</s:Boolean>
							</Setter.Value>
						</Setter>
						<Trigger.Value>
							<x:Static Member="MenuItemRole.TopLevelHeader" />
						</Trigger.Value>
