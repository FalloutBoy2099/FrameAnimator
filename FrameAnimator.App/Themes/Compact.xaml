<!--
    Compact versions of the Fluent controls (8 pt font, short controls), close to the original.
    This dictionary is loaded by each window: the base Fluent styles must exist at resolution time.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="10,2" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="20" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type RadioButton}}" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="20" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type GroupBox}}" TargetType="GroupBox">
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type ListViewItem}}" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0" />
    </Style>
</ResourceDictionary>