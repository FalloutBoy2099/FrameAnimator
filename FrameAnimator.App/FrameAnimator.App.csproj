<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>disable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <RootNamespace>FrameAnimator.App</RootNamespace>
        <AssemblyName>FrameAnimator</AssemblyName>
        <!-- Hand-written entry point: console mode (command line) or window. -->
        <StartupObject>FrameAnimator.App.Program</StartupObject>
        <ApplicationIcon>Assets\app.ico</ApplicationIcon>
        <!-- Native WPF Fluent theme (.NET 9+), still marked experimental. -->
        <NoWarn>$(NoWarn);WPF0001</NoWarn>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <Authors>Kain</Authors>
        <AssemblyVersion>2026.10.11.6</AssemblyVersion>
        <FileVersion>2026.10.11.6</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization\*.json" LogicalName="FrameAnimator.App.Localization.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Assets\**\*.png" />
        <Resource Include="Assets\app.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FrameAnimator.App.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FrameAnimator.Core\FrameAnimator.Core.csproj" />
    </ItemGroup>

</Project>
