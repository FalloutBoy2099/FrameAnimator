<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>FrameAnimator.Core</RootNamespace>
        <Description>Cœur de Frame Animator : modèle, formats FRM/FPR/FAS, palettes, quantification, codecs BMP/PNG/GIF.</Description>
        <AssemblyVersion>2026.10.12.8</AssemblyVersion>
        <FileVersion>2026.10.12.8</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Default palette (index 0 = 0x0000FF = background color), identical to the original's Default.act. -->
        <EmbeddedResource Include="Default.act" LogicalName="FrameAnimator.Core.Default.act" />
    </ItemGroup>

    <ItemGroup>
        <!-- Translations of the core messages (key = English format string), shared by the interface and the console mode. -->
        <EmbeddedResource Include="Messages\*.json" LogicalName="FrameAnimator.Core.Messages.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FrameAnimator.Core.Tests" />
    </ItemGroup>

</Project>